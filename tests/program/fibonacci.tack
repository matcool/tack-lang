// returns 0

fn print_num(num: i32) {
	if (num < 10) {
		let char: u8 = 0x30 + num as u8;
		tack_print(str {
			data: &char,
			size: 1,
		});
	} else {
		print_num(num / 10);
		print_num(num % 10);
	}
}

fn fib(i: i32): i32 {
	if i < 2 {
		return i;
	} else {
		return fib(i - 1) + fib(i - 2);
	}
}

fn main(): i32 {
	let i: i32 = 1;
	while i != 10 {
		print_num(fib(i));
		tack_print("\n");
		i = i + 1;
	}
	return 0;
}