// generates a qoi image

fn print_num(num: i32) {
	if (num < 10) {
		let char: u8 = 0x30 + num as u8;
		tack_print(str {
			data: &char,
			size: 1,
		});
	} else {
		print_num(num / 10);
		print_num(num % 10);
	}
}
fn println_num(num: i32) { print_num(num); tack_print("\n"); }

@c_extern fn fopen(path: u8*, mode: u8*): void*;
@c_extern fn fwrite(buffer: u8*, size: uptr, count: uptr, file: void*): uptr;
@c_extern fn fclose(file: void*): i32;

struct File {
	fd: void*;
	buffer: u8*;
	buffer_size: i32;
	buffer_cap: i32;

	fn flush(self) {
		if self.buffer_size != 0 {
			fwrite(self.buffer, 1, self.buffer_size as uptr, self.fd);
			self.buffer_size = 0;
		}
	}

	fn write(self, data: u8*, size: i32) {
		if size > self.buffer_cap {
			self.flush();
			fwrite(data, 1, size as uptr, self.fd);
		} else {
			if self.buffer_cap - self.buffer_size < size {
				self.flush();
			}
			tack_memcpy((self.buffer + self.buffer_size) as void*, data as void*, size as uptr);
			self.buffer_size = self.buffer_size + size;
		}
	}

	fn close(self) {
		self.flush();
		fclose(self.fd);
	}

	fn write_s(self, msg: str) {
		self.write(msg.data, msg.size);
	}

	fn write_byte(self, byte: u8) {
		self.write(&byte, 1);
	}

	fn write_i32_be(self, value: i32) {
		self.write_byte((value >> 24) as u8);
		self.write_byte((value >> 16) as u8);
		self.write_byte((value >> 8) as u8);
		self.write_byte(value as u8);
	}
}

fn open_file(name: str): File {
	let c_str: u8* = tack_malloc((name.size + 1) as uptr) as u8*;
	let i: i32 = 0;
	while i < name.size {
		c_str[i] = name.data[i];
		i = i + 1;
	}
	c_str[i] = 0;

	// TODO: relying on c string null term
	let fd: void* = fopen(c_str, "wb".data);

	return File {
		fd: fd,
		buffer: tack_malloc(1024) as u8*,
		buffer_size: 0,
		buffer_cap: 1024,
	};
}

struct Color {
	r: u8;
	g: u8;
	b: u8;
	a: u8;

	fn pack(self): i32 {
		return self.r as i32 << 24 | self.g as i32 << 16 | self.b as i32 << 8 | self.a as i32;
	}

	fn hash(self): i32 {
		return ((self.r as i32) * 3 + (self.g as i32) * 5 + (self.b as i32) * 7 + (self.a as i32) * 11) % 64;
	}

	fn eq(self, b: Color): bool {
		return self.r == b.r && self.g == b.g && self.b == b.b && self.a == b.a;
	}
}

fn unpack_color(color: i32): Color {
	let res: Color;
	res.r = (color >> 24) as u8;
	res.g = (color >> 16) as u8;
	res.b = (color >> 8) as u8;
	res.a = (color) as u8;
	return res;
}

fn wrap_diff(value: i32, prev: i32): i32 {
	// this is rly dumb
	let diff: i32 = value - prev;
	if diff + 256 < 100 { return diff + 256; }
	if diff - 256 > -100 { return diff - 256; }
	return diff;
}

fn save_image(name: str, pixels: i32*, width: i32, height: i32) {
	let file: File = open_file(name);

	// file header
	file.write_s("qoif");
	file.write_i32_be(width);
	file.write_i32_be(height);
	file.write_byte(4); // RGBA
	file.write_byte(0); // sRGB (idk what this means)

	let i: i32 = 0;
	let prev_color: Color = Color { r: 0, g: 0, b: 0, a: 255 };
	let run_length: i32 = 0;

	let color_array: i32* = tack_malloc(64 * 4) as i32*;
	while i < 64 {
		color_array[i] = 0;
		i = i + 1;
	}
	i = 0;

	let total_run: i32 = 0;
	let total_index: i32 = 0;
	let total_diff: i32 = 0;
	let total_luma: i32 = 0;
	let total_rgb: i32 = 0;
	let total_rgba: i32 = 0;

	while i < width * height {
		let raw_color: i32 = pixels[i];
		let color: Color = unpack_color(raw_color);
		let hash_index: i32 = color.hash();
		if color.eq(prev_color) && run_length < 61 {
			run_length = run_length + 1;
		} else {
			if run_length != 0 {
				// QOI_OP_RUN
				file.write_byte(0xc0 | (run_length - 1) as u8);
				run_length = 0;
				total_run = total_run + 1;
			}
			let hash_index_color: Color = unpack_color(color_array[hash_index]);
			if color.eq(hash_index_color) {
				// QOI_OP_INDEX
				file.write_byte(hash_index as u8);
				total_index = total_index + 1;
			} else if color.a == prev_color.a {
				let dr: i32 = wrap_diff(color.r as i32, prev_color.r as i32);
				let dg: i32 = wrap_diff(color.g as i32, prev_color.g as i32);
				let db: i32 = wrap_diff(color.b as i32, prev_color.b as i32);
				if dr >= -2 && dr <= 1 && dg >= -2 && dg <= 1 && db >= -2 && db <= 1 {
					// QOI_OP_DIFF
					let byte: u8 = 0x40 | ((dr + 2) << 4) as u8 | ((dg + 2) << 2) as u8 | (db + 2) as u8;
					file.write_byte(byte);
					total_diff = total_diff + 1;
				} else {
					let dr_dg: i32 = wrap_diff(dr, dg);
					let db_dg: i32 = wrap_diff(db, dg);
					if dg >= -32 && dg <= 31 && dr_dg >= -8 && dr_dg <= 7 && db_dg >= -8 && db_dg <= 7 {
						// QOI_OP_LUMA
						file.write_byte(0x80 | (dg + 32) as u8);
						file.write_byte(((dr_dg + 8) << 4) as u8 | (db_dg + 8) as u8);
						total_luma = total_luma + 1;
					} else {
						// QOI_OP_RGB
						file.write_byte(0xFE);
						file.write_byte(color.r);
						file.write_byte(color.g);
						file.write_byte(color.b);
						total_rgb = total_rgb + 1;
					}
				}
			} else {
				// QOI_OP_RGBA
				file.write_byte(0xFF);
				file.write_i32_be(raw_color);
				total_rgba = total_rgba + 1;
			}
		}

		color_array[hash_index] = color.pack();
		prev_color = color;

		i = i + 1;
	}
	if run_length != 0 {
		file.write_byte(0xc0 | (run_length - 1) as u8);
		run_length = 0;
		total_run = total_run + 1;
	}
	// mark end of stream
	file.write_s("\0\0\0\0\0\0\0");
	file.write_byte(1);
	file.close();

	tack_print("Total counts\n");
	tack_print("Total RUN: "); println_num(total_run);
	tack_print("Total INDEX: "); println_num(total_index);
	tack_print("Total DIFF: "); println_num(total_diff);
	tack_print("Total LUMA: "); println_num(total_luma);
	tack_print("Total RGB: "); println_num(total_rgb);
	tack_print("Total RGBA: "); println_num(total_rgba);
}

fn make_color(r: u8, g: u8, b: u8): i32 {
	return r as i32 << 24 | g as i32 << 16 | b as i32 << 8 | 0xFF;
}

fn main(): i32 {
	let width: i32 = 256;
	let height: i32 = 256;
	tack_print("welcome!\n");
	let canvas: i32* = tack_malloc((width * height * 4) as uptr) as i32*;

	let y: i32 = 0;
	while y < height {
		let x: i32 = 0;
		while x < width {
			let i: i32 = y * width + x;
			// canvas[i] = make_color(((x - 1) * (x - 1) - y * y) as u8, (x * x - y * y) as u8, ((x + 1) * (x + 1) - (y + 1) * (y + 1)) as u8);
			canvas[i] = make_color(((width - x) * (width - x) / (y + 1)) as u8, (x * x / (y + 1)) as u8, (x - y + 1) as u8);
			// canvas[i] = make_color(y as u8, y as u8, y as u8);
			x = x + 1;
		}
		y = y + 1;
	}

	tack_print("going to save!\n");
	save_image("./image.qoi", canvas, width, height);
	tack_print("saved\n");

	return 0;
}